# Copy this file to .env (or set these as real environment variables)
# and fill in the SAME MySQL credentials your PHP project already uses.

HMS_DB_HOST=localhost
HMS_DB_PORT=3306
HMS_DB_USER=root
HMS_DB_PASSWORD=
HMS_DB_NAME=hospital_management

HMS_FLASK_HOST=0.0.0.0
HMS_FLASK_PORT=5000
HMS_FLASK_DEBUG=True

# Comma-separated list of origins your PHP site runs on.
HMS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Hospital info used by faq.py's answers (Phase 6) - replace with your real details.
HMS_HOSPITAL_NAME=Our Hospital
HMS_HOSPITAL_TIMINGS=Monday to Saturday, 8:00 AM to 8:00 PM
HMS_HOSPITAL_PHONE=+91-XXXXXXXXXX
HMS_HOSPITAL_EMAIL=info@yourhospital.com
HMS_HOSPITAL_ADDRESS=123 Hospital Road, Your City
HMS_EMERGENCY_PHONE=+91-XXXXXXXXXX
HMS_EMERGENCY_24_7=True

